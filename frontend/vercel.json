{
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "https://naveenrod.github.io/Crypto-stock-webpage/data/:path*"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=900" }
      ]
    }
  ]
}
